# ============================================================
# BSV Solo Mining Dashboard - Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.
# ============================================================

# --- Sicherheit ---
SECRET_KEY=bitte-einen-langen-zufaelligen-wert-eintragen
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=bitte-sofort-nach-erstem-login-aendern

# --- PostgreSQL ---
POSTGRES_USER=bsvdash
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=bsvdash
DATABASE_URL=postgresql+psycopg2://bsvdash:bitte-aendern@postgres:5432/bsvdash

# --- Bitcoin SV Full Node (bitcoind RPC) ---
BSV_RPC_HOST=127.0.0.1
BSV_RPC_PORT=8332
BSV_RPC_USER=rpcuser
BSV_RPC_PASSWORD=rpcpassword
WALLET_NAME=

# --- Stratum Solo-Mining Server ---
STRATUM_API_URL=http://127.0.0.1:9000/stats
STRATUM_LOG_PATH=/var/log/stratum/stratum.log
STRATUM_POLL_INTERVAL_SECONDS=10
MINER_OFFLINE_THRESHOLD_SECONDS=120

# --- Telegram Benachrichtigungen ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Sonstiges ---
CORS_ORIGINS=["*"]
