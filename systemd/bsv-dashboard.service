# ============================================================
# systemd-Unit fuer den nativen (nicht-containerisierten) Betrieb des
# BSV Solo Mining Dashboard Backends auf 5tratumOS / Raspberry Pi OS.
#
# Installation:
#   sudo cp systemd/bsv-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bsv-dashboard
# ============================================================
[Unit]
Description=BSV Solo Mining Dashboard (Backend) - by DeepDance
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=bsvdash
Group=bsvdash
WorkingDirectory=/opt/bsv-dashboard/backend
EnvironmentFile=/opt/bsv-dashboard/.env
ExecStart=/opt/bsv-dashboard/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/bsv-dashboard

[Install]
WantedBy=multi-user.target
